{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory.schema.json",
  "title": "Measured memory use (row of data/observations/memory.csv)",
  "description": "Measured (not estimated) peak memory while running a model. Estimates are computed at build time from artifacts + architecture and are never stored here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_id", "quant", "runtime_id", "hardware_id", "offload", "source_id"],
  "anyOf": [{ "required": ["vram_gb"] }, { "required": ["ram_gb"] }],
  "properties": {
    "model_id": { "type": "string" },
    "quant": { "type": "string" },
    "runtime_id": { "type": "string" },
    "hardware_id": { "type": "string" },
    "offload": { "enum": ["none", "layer-offload", "moe-expert-offload", "disk-streaming", "other"] },
    "context_tokens": { "type": "integer", "minimum": 0 },
    "kv_cache_type": { "type": "string", "description": "f16, q8_0, q4_0, fp8, ..." },
    "vram_gb": { "type": "number", "minimum": 0 },
    "ram_gb": { "type": "number", "minimum": 0 },
    "source_id": { "type": "string" },
    "locator": { "type": "string" },
    "notes": { "type": "string" }
  }
}
