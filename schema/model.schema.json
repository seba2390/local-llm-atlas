{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model.schema.json",
  "title": "Model",
  "description": "One YAML file per released model (open or closed weights) in data/models/<org>/<id>.yaml. Closed models that change behind one name should get one record per dated API snapshot where the provider publishes one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "org",
    "release_date",
    "open_weights",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string"
    },
    "org": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "family": {
      "type": "string"
    },
    "variant": {
      "enum": [
        "base",
        "instruct",
        "reasoning",
        "hybrid-reasoning",
        "distill",
        "other"
      ]
    },
    "base_model": {
      "type": "string",
      "description": "Atlas id of the model this was fine-tuned/distilled from."
    },
    "release_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
    },
    "open_weights": {
      "type": "boolean"
    },
    "license": {
      "type": "string"
    },
    "weights_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "api_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Provider API identifiers / dated snapshots, e.g. 'claude-3-5-sonnet-20241022'."
    },
    "context_length": {
      "type": "integer",
      "minimum": 1
    },
    "modalities": {
      "type": "array",
      "items": {
        "enum": [
          "text",
          "image",
          "audio",
          "video"
        ]
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "params_total_b"
      ],
      "properties": {
        "type": {
          "enum": [
            "dense",
            "moe",
            "hybrid-ssm",
            "hybrid-ssm-moe",
            "ssm",
            "diffusion",
            "other"
          ]
        },
        "params_total_b": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "params_active_b": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "params_non_embedding_b": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "layers": {
          "type": "integer",
          "minimum": 1
        },
        "hidden_size": {
          "type": "integer",
          "minimum": 1
        },
        "attention": {
          "enum": [
            "mha",
            "gqa",
            "mqa",
            "mla",
            "sliding-window",
            "hybrid",
            "linear",
            "other"
          ]
        },
        "q_heads": {
          "type": "integer",
          "minimum": 1
        },
        "kv_heads": {
          "type": "integer",
          "minimum": 1
        },
        "head_dim": {
          "type": "integer",
          "minimum": 1
        },
        "experts_total": {
          "type": "integer",
          "minimum": 1
        },
        "experts_active": {
          "type": "integer",
          "minimum": 1
        },
        "experts_shared": {
          "type": "integer",
          "minimum": 0
        },
        "native_dtype": {
          "enum": [
            "fp32",
            "bf16",
            "fp16",
            "fp8",
            "fp4",
            "int4",
            "mixed"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "Required for open-weight models. For closed models fill only what the provider officially discloses; never fill from rumours or third-party guesses."
    },
    "sources": {
      "description": "Default citations for this record.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "field_sources": {
      "description": "Per-field citation overrides, keyed by dotted path, e.g. 'architecture.params_total_b'.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "open_weights": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "architecture",
          "weights_url"
        ]
      }
    }
  ]
}
