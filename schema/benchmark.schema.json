{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark.schema.json",
  "title": "Benchmark",
  "description": "One YAML file per benchmark in data/benchmarks/. Different benchmarks that share a brand (e.g. Aider code-editing vs Aider Polyglot) MUST be separate entries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "metric",
    "unit",
    "higher_is_better",
    "url",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "enum": [
        "code-generation",
        "code-editing",
        "competitive-programming",
        "software-engineering",
        "terminal-agent",
        "tool-use",
        "agentic",
        "computer-use",
        "math",
        "reasoning",
        "knowledge",
        "science",
        "commonsense",
        "reading-comprehension",
        "language-modeling",
        "instruction-following",
        "long-context",
        "multimodal",
        "writing",
        "forecasting",
        "games",
        "cybersecurity",
        "research",
        "chat-arena",
        "safety",
        "other"
      ]
    },
    "metric": {
      "type": "string",
      "description": "Default headline metric, e.g. pass@1, pass_rate_2, resolved_rate."
    },
    "unit": {
      "enum": [
        "percent",
        "score",
        "elo",
        "minutes",
        "usd",
        "ratio"
      ]
    },
    "higher_is_better": {
      "type": "boolean"
    },
    "harness_sensitive": {
      "type": "boolean",
      "description": "True if the score depends materially on the harness/scaffold (agentic benchmarks). Scores with harness 'undisclosed' then get a warning."
    },
    "introduced": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$",
      "description": "First public release; scores reported before this date are flagged."
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "variants": {
      "description": "Allowed values of scores.variant. If omitted, variant must be empty.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "introduced": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "managed_by": {
      "type": "string",
      "description": "Importer that owns (regenerates) this record."
    }
  }
}
