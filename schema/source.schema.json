{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "Source (citation)",
  "description": "Every fact in the atlas points at one of these. One YAML file per source in data/sources/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "title", "url", "accessed", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "kind": {
      "enum": ["paper", "tech_report", "model_card", "model_config", "leaderboard", "leaderboard_data", "blog", "repo", "docs", "forum", "spec_sheet", "measurement"]
    },
    "provenance": {
      "description": "first_party = published by the model/hardware/runtime creator; third_party = independent evaluator; community = forum/user reports; own_measurement = run by this project.",
      "enum": ["first_party", "third_party", "community", "own_measurement"]
    },
    "title": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "pattern": "^https?://" },
    "publisher": { "type": "string" },
    "authors": { "type": "array", "items": { "type": "string" } },
    "published": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
    "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "revision": { "type": "string", "description": "Git commit / HF revision the data was read at, for reproducibility." },
    "archive_url": { "type": "string", "pattern": "^https?://" },
    "notes": { "type": "string" }
  }
}
